# Site Settings
title: My Awesome Website
description: A website with a main page and an active sidebar.
url: "https://yourwebsite.com" # Change this to your actual URL when you publish

# Theme Configuration
# We use 'just-the-docs' because it has excellent built-in active sidebars.
theme: just-the-docs

# Sidebar Navigation Settings
search_enabled: true         # Adds a search bar to the top of the sidebar
nav_sort: case_insensitive   # Sorts sidebar items alphabetically

# Exclude these files from being built
exclude:
  - Gemfile
  - Gemfile.lock
  - node_modules
  - vendor/bundle/